# Copie este arquivo para .env e revise os valores antes de executar o Makefile:
#   cp .env.example .env
#   make training     # banco local, modo de treinamento
#   make production   # banco local, modo de produção
#   make external     # banco PostgreSQL externo, sempre em produção

# Banco PostgreSQL. Para o banco local do Compose, mantenha POSTGRES_HOST=db.
# No alvo external, informe o hostname alcançável a partir do container;
# no Docker Desktop, host.docker.internal costuma apontar para o host.
POSTGRES_DB=esus
POSTGRES_USER=postgres
POSTGRES_PASS=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Modo padrão usado por make training. Os alvos production e external
# sobrescrevem este valor para false.
TRAINING=true

# JAR local ou URL de uma versão específica. Deixe vazio para baixar
# automaticamente a versão mais recente publicada no portal SISAPS.
FILENAME=

# Fuso horário usado pela imagem e pela aplicação.
TZ=America/Bahia

# Domínio usado pelo instalador para configurar HTTPS. Deixe vazio quando
# TLS for terminado por um proxy reverso ou não for configurado nesta etapa.
HTTPS_DOMAIN=
